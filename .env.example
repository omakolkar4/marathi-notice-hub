# ==============================================================================
# Marathi Notice Hub - Environment Configuration Template
# Academic Project: Marathi NLP-Based Intelligent Notice Management System
# Copy this file to .env and configure for your local or production environment
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME="Marathi Notice Hub"
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# Security & Authentication (Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# ----------------------
# For Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@<db_host>:5432/<db_name>
#
# For Local Development (Default SQLite in project workspace):
# DATABASE_URL=sqlite:///./marathi_notice_hub.db
DATABASE_URL=sqlite:///./marathi_notice_hub.db

# NLP Policy Thresholds
NLP_CONFIDENCE_THRESHOLD=0.30
REQUIRE_ADMIN_APPROVAL_FOR_FACULTY_NOTICES=True
